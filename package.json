{
  "name": "sccl-website",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "badges": "node scripts/fetch-badges.mjs && node scripts/gen-badges-css.mjs",
    "badges:force": "node scripts/fetch-badges.mjs --force && node scripts/gen-badges-css.mjs",
    "gen": "node scripts/gen-content.mjs",
    "dev": "npm run badges && npm run gen && zine",
    "build": "npm run badges:force && npm run gen && zine release -f",
    "og-image": "node scripts/og-image.mjs",
    "preview": "npm run build && npx serve public"
  },
  "devDependencies": {
    "playwright": "^1.61.1"
  }
}

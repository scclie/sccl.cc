---
export interface Props {
  platform: string;
  username: string;
  url: string;
  icon: string;
}

const { platform, username, url, icon } = Astro.props;
---

<a href={url} target="_blank" class="flex items-center space-x-3 p-3 rounded-lg hover:bg-nord-4 dark:hover:bg-nord-2 transition-all duration-300 group">
  <span class="text-xl">{icon}</span>
  <div>
    <p class="font-medium text-nord-1 dark:text-nord-6">{platform}</p>
    <p class="text-sm text-nord-3 dark:text-nord-4 group-hover:text-nord-8">{username}</p>
  </div>
</a>
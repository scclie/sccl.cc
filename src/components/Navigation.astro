---
// Minimalist Navigation Component - Inside Card
const currentPath = Astro.url.pathname;

// Determine accent color based on current page
let accentColor = 'var(--fg)'; // default white
if (currentPath.includes('/contacts')) {
  accentColor = 'var(--contacts-accent)';
} else if (currentPath.includes('/projects')) {
  accentColor = 'var(--projects-accent)';
} else if (currentPath.includes('/peripherals')) {
  accentColor = 'var(--peripherals-accent)';
}
---

<nav class="nav" style={`--page-accent: ${accentColor}`}>
  <div class="nav-links">
    <a href="/contacts" class:list={[{active: currentPath.includes('/contacts')}]}>contacts</a>
    <a href="/projects" class:list={[{active: currentPath.includes('/projects')}]}>projects</a>
    <a href="/peripherals" class:list={[{active: currentPath.includes('/peripherals')}]}>peripherals</a>
  </div>
</nav>

<style>
  .nav {
    margin-bottom: 25px;
    padding-bottom: 15px;
    border-bottom: 1px solid var(--page-accent);
  }
  
  .nav-links {
    display: flex;
    gap: 25px;
    justify-content: center;
  }
  
  .nav-links a {
    color: var(--fg);
    text-decoration: none;
    font-size: 20px;
    transition: color 0.1s;
  }
  
  .nav-links a:hover,
  .nav-links a.active {
    color: var(--page-accent);
  }
  
  /* Focus states for accessibility */
  .nav-links a:focus {
    outline: 2px solid var(--page-accent);
    outline-offset: 2px;
  }
  
  /* Responsive design - Mobile */
  @media (max-width: 767px) {
    .nav-links {
      gap: 15px;
      flex-wrap: wrap;
    }
  }
</style>
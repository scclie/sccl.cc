---
export interface Props {
  currentTab: string;
}

const { currentTab = 'contacts' } = Astro.props;

const tabs = [
  { id: 'contacts', label: 'Contacts', icon: '💬', href: '/contacts' },
  { id: 'products', label: 'Products', icon: '🚀', href: '/products' },
  { id: 'peripherals', label: 'Peripherals', icon: '🖥️', href: '/peripherals' }
];

const contacts = [
  { platform: 'Discord', username: '@sccl', url: 'https://discord.com/users/sccl', icon: '💬' },
  { platform: 'Telegram', username: '@papersacculos', url: 'https://t.me/papersacculos', icon: '✈️' },
  { platform: 'Steam', username: 'papersacculos', url: 'https://steamcommunity.com/id/papersacculos/', icon: '🎮' },
  { platform: 'YouTube', username: '@papersaccul', url: 'https://www.youtube.com/@papersaccul', icon: '📹' }
];

const products = [
  { title: 'Wiki', description: 'Personal knowleage with my articles', url: 'https://wiki.sccl.cc', icon: '📚' },
  { title: 'HeatKeys', description: 'Keyboard layout heatmap', url: 'https://heatkeys.sccl.cc', icon: '⌨️' }
];

const peripherals = [
  { category: 'CPU', items: ['AMD Ryzen 5 5600X @ 4.7GHz'] },
  { category: 'GPU', items: ['AMD Radeon RX 6750 XT (12GiB)'] },
  { category: 'RAM', items: ['32GiB DDR4-3333 CL16'] },
  { category: 'Monitor', items: ['MSI 26.5" MAG 272QP X50 (1440p, 500Hz)'] },
  { category: 'Mouses', items: ['Ninjutso Sora V2 (Artisan P8 dots)', 'Lamzu Thorn (x-raypad obsidian)'] },
  { category: 'Pads', items: ['Artisan Raiden Mid', 'Artisan Key-83 Soft', 'MeowGamingGear UltraNeon', 'X-RayPad Aqua-Control 2', 'Razer Gigantus v2'] },
  { category: 'Keyboard', items: ['M1W Custom (Boba U4T)'] },
  { category: 'Audio', items: ['Arturia MiniFuse 2', 'Philips shp9500', 'Maono PD100 XLR'] }
];
---

<div class="w-full max-w-4xl h-[85vh] min-h-[600px] max-h-[800px]">
  <div class="bg-nord-6 dark:bg-nord-0 rounded-2xl border border-nord-4 dark:border-nord-2 shadow-2xl overflow-hidden h-full flex flex-col">
    <div class="grid md:grid-cols-3 flex-1 overflow-hidden">
      <!-- Левая колонка - Профиль -->
      <div class="md:col-span-1 bg-gradient-to-br from-nord-8/10 to-nord-10/10 dark:from-nord-1 dark:to-nord-2 p-8 flex flex-col overflow-hidden">
        <div class="text-center md:text-left flex flex-col h-full">
          <!-- Аватар -->
          <div class="flex-shrink-0">
            <div class="relative w-24 h-24 mx-auto md:mx-0 mb-6">
              <!-- Свечение -->
              <div class="absolute -inset-2 rounded-full bg-gradient-to-r from-pink-500 via-purple-500 to-pink-500 opacity-70 blur-md animate-glow-pink group-hover:opacity-100 transition-opacity duration-500"></div>
              <div class="absolute -inset-1 rounded-full bg-gradient-to-r from-purple-400 via-pink-400 to-purple-400 opacity-50 blur-sm animate-glow-pink-delayed group-hover:opacity-80 transition-opacity duration-500"></div>
              
              <!-- Аватарка -->
              <div class="relative w-24 h-24 rounded-full flex items-center justify-center border-4 border-nord-6 dark:border-nord-0 shadow-2xl overflow-hidden bg-nord-4 group">
                <img 
                  src="/img/pfp.jpg" 
                  alt="sccl" 
                  class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                  onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                />
                <div class="w-full h-full bg-gradient-to-br from-nord-8 to-nord-10 hidden items-center justify-center">
                  <span class="text-2xl text-nord-6 font-bold">SC</span>
                </div>
              </div>
            </div>
          </div>
          
          <!-- Имя -->
          <div class="flex-shrink-0">
            <h1 class="text-3xl font-bold text-nord-1 dark:text-nord-6 mb-2">paper_sacculos</h1>
          </div>
          
          <!-- Теги -->
          <div class="flex-shrink-0 mb-6">
            <div class="flex flex-wrap gap-2 justify-center md:justify-start">
              <span class="px-3 py-1 bg-nord-8/20 text-nord-10 dark:text-nord-8 text-sm rounded-full border border-nord-8/30">Developer</span>
              <span class="px-3 py-1 bg-nord-9/20 text-nord-10 dark:text-nord-9 text-sm rounded-full border border-nord-9/30">Aimer</span>
            </div>
          </div>
          
          <!-- Обо мне -->
          <div class="flex-1 min-h-0 mb-6">
            <div class="prose prose-sm dark:prose-invert h-full">
              <p class="text-nord-2 dark:text-nord-4 leading-relaxed">
                
              </p>
            </div>
          </div>
        </div>
        
        <!-- Статус 
        <div class="flex-shrink-0">
          <div class="p-3 bg-nord-6/50 dark:bg-nord-1/50 rounded-lg border border-nord-4/50 dark:border-nord-2/50">
            <div class="flex items-center space-x-2">
              div class="w-2 h-2 bg-green-500 rounded-full animate-pulse"></div>
              <span class="text-sm text-nord-2 dark:text-nord-4">text</span>
            </div>
          </div>
        </div>-->
      </div> 
      
      <!-- Правая колонка - Вкладки -->
      <div class="md:col-span-2 p-8 flex flex-col overflow-hidden">
        <!-- Переключатель вкладок -->
        <div class="flex space-x-1 mb-8 p-1 bg-nord-5 dark:bg-nord-1 rounded-lg shrink-0">
          {tabs.map((tab) => (
            <a
              href={tab.href}
              class={`flex items-center space-x-2 px-4 py-2 rounded-md text-sm font-medium transition-all duration-300 flex-1 justify-center ${
                currentTab === tab.id
                  ? 'bg-nord-6 dark:bg-nord-0 text-nord-10 shadow-sm'
                  : 'text-nord-3 dark:text-nord-4 hover:text-nord-1 dark:hover:text-nord-6'
              }`}
            >
              <span>{tab.icon}</span>
              <span class="hidden sm:inline">{tab.label}</span>
            </a>
          ))}
        </div>
        
        <!-- Контент вкладок с кастомным скроллбаром -->
        <div class="flex-1 min-h-0 overflow-hidden relative">
          <div class="h-full overflow-y-auto scrollbar-custom pr-4">
            <!-- Контакты -->
            {currentTab === 'contacts' && (
              <div class="space-y-4 animate-fade-in">
                {contacts.map((contact) => (
                  <a 
                    href={contact.url} 
                    target="_blank"
                    class="flex items-center space-x-4 p-4 rounded-lg hover:bg-nord-5 dark:hover:bg-nord-1 transition-all duration-300 group border border-nord-4/50 dark:border-nord-2/50"
                  >
                    <span class="text-2xl">{contact.icon}</span>
                    <div class="flex-1">
                      <h3 class="font-semibold text-nord-1 dark:text-nord-6 group-hover:text-nord-8">
                        {contact.platform}
                      </h3>
                      <p class="text-sm text-nord-3 dark:text-nord-4 group-hover:text-nord-8">
                        {contact.username}
                      </p>
                    </div>
                    <span class="text-nord-4 dark:text-nord-2 group-hover:text-nord-8">→</span>
                  </a>
                ))}
              </div>
            )}
            
            <!-- Продукты -->
            {currentTab === 'products' && (
              <div class="grid gap-4 animate-fade-in">
                {products.map((product) => (
                  <a 
                    href={product.url} 
                    target="_blank"
                    class="block p-4 rounded-lg hover:bg-nord-5 dark:hover:bg-nord-1 transition-all duration-300 group border border-nord-4/50 dark:border-nord-2/50"
                  >
                    <div class="flex items-center space-x-4">
                      <span class="text-2xl">{product.icon}</span>
                      <div class="flex-1">
                        <h3 class="font-semibold text-nord-1 dark:text-nord-6 group-hover:text-nord-8 mb-1">
                          {product.title}
                        </h3>
                        <p class="text-sm text-nord-3 dark:text-nord-4">
                          {product.description}
                        </p>
                      </div>
                      <span class="text-nord-4 dark:text-nord-2 group-hover:text-nord-8">↗</span>
                    </div>
                  </a>
                ))}
              </div>
            )}
            
            <!-- Периферия -->
            {currentTab === 'peripherals' && (
              <div class="space-y-6 animate-fade-in pb-4">
                {peripherals.map((peripheral) => (
                  <div class="border-b border-nord-4/30 dark:border-nord-2/30 pb-4 last:border-b-0 last:pb-0">
                    <h3 class="font-semibold text-nord-1 dark:text-nord-6 mb-3 text-sm uppercase tracking-wider">
                      {peripheral.category}
                    </h3>
                    <div class="space-y-2">
                      {peripheral.items.map((item) => (
                        <div class="flex items-center space-x-3 text-sm text-nord-2 dark:text-nord-4">
                          <div class="w-1.5 h-1.5 bg-nord-8 rounded-full flex-shrink-0"></div>
                          <span class="break-words">{item}</span>
                        </div>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .animate-fade-in {
    animation: fadeIn 0.3s ease-in-out;
  }
  
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .prose {
    max-width: none;
  }
  
  /* Кастомный красивый скроллбар */
  .scrollbar-custom {
    scrollbar-width: thin;
    scrollbar-color: #88c0d0 transparent;
  }
  
  .scrollbar-custom::-webkit-scrollbar {
    width: 8px;
  }
  
  .scrollbar-custom::-webkit-scrollbar-track {
    background: transparent;
    border-radius: 4px;
    margin: 4px 0;
  }
  
  .scrollbar-custom::-webkit-scrollbar-thumb {
    background: linear-gradient(135deg, #88c0d0, #81a1c1);
    border-radius: 4px;
    border: 2px solid transparent;
    background-clip: padding-box;
    transition: all 0.3s ease;
  }
  
  .scrollbar-custom::-webkit-scrollbar-thumb:hover {
    background: linear-gradient(135deg, #81a1c1, #5e81ac);
    border: 1px solid transparent;
    background-clip: padding-box;
  }
  
  .scrollbar-custom::-webkit-scrollbar-thumb:active {
    background: linear-gradient(135deg, #5e81ac, #4c566a);
  }
  
  .dark .scrollbar-custom::-webkit-scrollbar-thumb {
    background: linear-gradient(135deg, #4c566a, #434c5e);
  }
  
  .dark .scrollbar-custom::-webkit-scrollbar-thumb:hover {
    background: linear-gradient(135deg, #434c5e, #3b4252);
  }
  
  .dark .scrollbar-custom::-webkit-scrollbar-thumb:active {
    background: linear-gradient(135deg, #3b4252, #2e3440);
  }
  
  /* Плавная прокрутка */
  .scrollbar-custom {
    scroll-behavior: smooth;
  }
  
  /* Анимация появления скроллбара */
  .scrollbar-custom::-webkit-scrollbar-thumb {
    opacity: 0.7;
  }
  
  .scrollbar-custom:hover::-webkit-scrollbar-thumb {
    opacity: 1;
  }
  
  /* Градиентные эффекты для скроллбара */
  .scrollbar-custom::-webkit-scrollbar-thumb {
    position: relative;
  }
  
  .scrollbar-custom::-webkit-scrollbar-thumb::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(45deg, transparent 30%, rgba(255,255,255,0.3) 50%, transparent 70%);
    border-radius: 4px;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  
  .scrollbar-custom::-webkit-scrollbar-thumb:hover::before {
    opacity: 1;
  }

  /* Анимации свечения авы */
  @keyframes flame1 {
    0%, 100% {
      transform: translateY(0) scale(1) rotate(0deg);
      opacity: 0.8;
    }
    25% {
      transform: translateY(-2px) scale(1.1) rotate(-5deg);
      opacity: 1;
    }
    50% {
      transform: translateY(-4px) scale(1.2) rotate(0deg);
      opacity: 0.9;
    }
    75% {
      transform: translateY(-1px) scale(1.05) rotate(5deg);
      opacity: 0.7;
    }
  }

  @keyframes flame2 {
    0%, 100% {
      transform: translateY(0) scale(1) rotate(0deg);
      opacity: 0.7;
    }
    33% {
      transform: translateY(-3px) scale(1.15) rotate(3deg);
      opacity: 0.9;
    }
    66% {
      transform: translateY(-1px) scale(1.05) rotate(-2deg);
      opacity: 0.6;
    }
  }

  @keyframes flame3 {
    0%, 100% {
      transform: translateY(0) scale(1) rotate(0deg);
      opacity: 0.6;
    }
    20% {
      transform: translateY(-2px) scale(1.1) rotate(-3deg);
      opacity: 0.8;
    }
    40% {
      transform: translateY(-4px) scale(1.25) rotate(0deg);
      opacity: 1;
    }
    60% {
      transform: translateY(-3px) scale(1.15) rotate(2deg);
      opacity: 0.7;
    }
    80% {
      transform: translateY(-1px) scale(1.05) rotate(-1deg);
      opacity: 0.5;
    }
  }

  @keyframes flame4 {
    0%, 100% {
      transform: translateY(0) scale(1);
      opacity: 0.5;
    }
    50% {
      transform: translateY(-2px) scale(1.1);
      opacity: 0.8;
    }
  }

  @keyframes flame5 {
    0%, 100% {
      transform: translateY(0) scale(1) rotate(0deg);
      opacity: 0.6;
    }
    25% {
      transform: translateY(-1px) scale(1.05) rotate(2deg);
      opacity: 0.7;
    }
    50% {
      transform: translateY(-3px) scale(1.2) rotate(0deg);
      opacity: 0.9;
    }
    75% {
      transform: translateY(-2px) scale(1.1) rotate(-2deg);
      opacity: 0.5;
    }
  }

  @keyframes pulseSlow {
    0%, 100% {
      opacity: 0.3;
    }
    50% {
      opacity: 0.6;
    }
  }

  .animate-flame-1 {
    animation: flame1 2s ease-in-out infinite;
  }

  .animate-flame-2 {
    animation: flame2 2.5s ease-in-out infinite;
    animation-delay: 0.3s;
  }

  .animate-flame-3 {
    animation: flame3 3s ease-in-out infinite;
    animation-delay: 0.6s;
  }

  .animate-flame-4 {
    animation: flame4 2.2s ease-in-out infinite;
    animation-delay: 0.9s;
  }

  .animate-flame-5 {
    animation: flame5 2.8s ease-in-out infinite;
    animation-delay: 1.2s;
  }

  .animate-pulse-slow {
    animation: pulseSlow 4s ease-in-out infinite;
  }

  /* Эффекты при наведении */
  .group:hover .animate-flame-1 {
    animation-duration: 1.5s;
  }

  .group:hover .animate-flame-2 {
    animation-duration: 2s;
  }

  .group:hover .animate-flame-3 {
    animation-duration: 2.5s;
  }

  .group:hover .animate-flame-4 {
    animation-duration: 1.8s;
  }

  .group:hover .animate-flame-5 {
    animation-duration: 2.2s;
  }

  .group:hover .animate-pulse-slow {
    animation-duration: 3s;
  }
</style>

<script>
  // Добавляем интерактивность для скроллбара
  document.addEventListener('DOMContentLoaded', function() {
    const scrollContainers = document.querySelectorAll('.scrollbar-custom');
    
    scrollContainers.forEach(container => {
      // Добавляем плавную прокрутку при использовании колесика
      container.addEventListener('wheel', function(e) {
        e.preventDefault();
        this.scrollBy({
          top: e.deltaY * 0.5,
          behavior: 'smooth'
        });
      }, { passive: false });
    });
  });
</script>
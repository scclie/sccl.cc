---
import Navigation from './Navigation.astro';

export interface Props {
  currentTab: string;
}

const { currentTab = 'contacts' } = Astro.props;

// Determine accent color based on current tab
let accentColor = 'var(--fg)'; // default
if (currentTab === 'contacts') {
  accentColor = 'var(--contacts-accent)';
} else if (currentTab === 'projects') {
  accentColor = 'var(--projects-accent)';
} else if (currentTab === 'peripherals') {
  accentColor = 'var(--peripherals-accent)';
}
---

<div class="card scanlines" style={`--card-accent: ${accentColor}`}>
  <Navigation />
  
  <div class="card-header">
    <img src="/img/pfpnew15.png" alt="sccl avatar" class="avatar" />
    <div class="header-info">
      <span class="user">[pipre@scclie ~]$</span>
      <p class="bio">/ˈsʌk.kʊ.li/</p>
    </div>
  </div>

  <div class="card-content">
    <slot />
  </div>

  <div class="card-footer">
    <span>{currentTab}.md</span>
    <span class="symbol">;</span>
  </div>
</div>

<script>
  // Рандомизация цветов box-shadow
  class CardShadowRandomizer {
    constructor() {
      this.card = document.querySelector('.card');
      if (!this.card) return;
      
      this.colors = [
        'rgba(255, 0, 255, 0.4)',   // Маджента
        'rgba(0, 255, 255, 0.4)',   // Циан
        'rgba(204, 255, 0, 0.3)',   // Салатовый
        'rgba(255, 0, 136, 0.3)',   // Розовый
        'rgba(136, 0, 255, 0.4)',   // Фиолетовый
        'rgba(0, 255, 0, 0.3)',     // Зеленый
      ];
      
      this.isAnimating = true;
      this.animate();
    }
    
    getRandomColor() {
      return this.colors[Math.floor(Math.random() * this.colors.length)];
    }
    
    updateShadow() {
      if (!this.card) return;
      
      const accentColor = getComputedStyle(this.card).getPropertyValue('--card-accent').trim();
      
      // Базовые тени (как раньше)
      const baseShadows = [
        `4px 0 0 ${accentColor}`,
        `-4px 0 0 ${accentColor}`,
        `0 4px 0 ${accentColor}`,
        `0 -4px 0 ${accentColor}`
      ];
      
      // МНОГО рандомных цветных теней по всей рамке равномерно
      const randomShadows = [];
      
      // Верх и низ
      for (let i = 0; i < 8; i++) {
        const x = Math.random() * 24 - 12;
        const y = Math.random() > 0.5 ? Math.random() * 8 + 8 : -(Math.random() * 8 + 8);
        randomShadows.push(`${x}px ${y}px 0 ${this.getRandomColor()}`);
      }
      
      // Лево и право
      for (let i = 0; i < 8; i++) {
        const x = Math.random() > 0.5 ? Math.random() * 8 + 8 : -(Math.random() * 8 + 8);
        const y = Math.random() * 24 - 12;
        randomShadows.push(`${x}px ${y}px 0 ${this.getRandomColor()}`);
      }
      
      // Углы
      for (let i = 0; i < 4; i++) {
        const x = Math.random() * 16 - 8;
        const y = Math.random() * 16 - 8;
        randomShadows.push(`${x}px ${y}px 0 ${this.getRandomColor()}`);
      }
      
      this.card.style.boxShadow = [...baseShadows, ...randomShadows].join(', ');
    }
    
    animate() {
      if (!this.isAnimating) return;
      this.updateShadow();
      setTimeout(() => this.animate(), 100 + Math.random() * 150);
    }
    
    stop() {
      this.isAnimating = false;
    }
  }
  
  // Глобальная переменная
  let cardShadowInstance = null;
  
  function initCardShadow() {
    if (cardShadowInstance) {
      cardShadowInstance.stop();
    }
    cardShadowInstance = new CardShadowRandomizer();
  }
  
  // Инициализация при загрузке и после ViewTransitions
  document.addEventListener('DOMContentLoaded', initCardShadow);
  document.addEventListener('astro:page-load', initCardShadow);
</script>

<style>
  .card {
    max-width: 900px;
    width: 100%;
    margin: 0 auto;
    background: var(--bg);
    position: relative;
    padding: 25px;
    border: 2px solid var(--card-accent);
    /* box-shadow добавляется через JavaScript */
  }
  
  .card-header {
    display: flex;
    gap: 20px;
    align-items: center;
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--card-accent);
  }
  
  .avatar {
    width: 80px;
    height: 80px;
    border: 2px solid var(--card-accent);
    image-rendering: pixelated;
    flex-shrink: 0;
  }
  
  .header-info {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  
  .user {
    color: var(--card-accent);
    font-size: 30px;
    font-weight: bold;
  }
  
  .status {
    color: var(--fg);
    font-size: 20px;
  }
  
  .bio {
    color: var(--fg-dim);
    font-size: 20px;
    margin-top: 8px;
    line-height: 1.6;
  }
  
  .card-content {
    min-height: 300px;
    color: var(--fg);
    font-size: 20px;
    line-height: 2;
  }
  
  .card-footer {
    margin-top: 30px;
    padding-top: 15px;
    border-top: 1px solid var(--card-accent);
    display: flex;
    justify-content: space-between;
    font-size: 20px;
    color: var(--fg-dim);
  }
  
  .symbol {
    color: var(--card-accent);
  }
  
  /* Responsive design - Mobile */
  @media (max-width: 767px) {
    .card {
      margin: 5px;
      padding: 5px;
    }
    
    .card-header {
      flex-direction: column;
      text-align: center;
      align-items: center;
    }
    
    .avatar {
      width: 128px;
      height: 128px;
    }
    
    .card-content {
      font-size: 12px;
      min-height: 20px;
    }
  }
</style>

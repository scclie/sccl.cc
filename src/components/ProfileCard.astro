---
import Navigation from './Navigation.astro';

export interface Props {
  currentTab: string;
}

const { currentTab = 'contacts' } = Astro.props;

// Determine accent color based on current tab
let accentColor = 'var(--fg)'; // default
if (currentTab === 'contacts') {
  accentColor = 'var(--contacts-accent)';
} else if (currentTab === 'projects') {
  accentColor = 'var(--projects-accent)';
} else if (currentTab === 'peripherals') {
  accentColor = 'var(--peripherals-accent)';
}
---

<div class="card scanlines" style={`--card-accent: ${accentColor}`}>
  <Navigation />
  
  <div class="card-header">
    <img src="/img/pfpnew15.png" alt="sccl avatar" class="avatar" />
    <div class="header-info">
      <span class="user">[pipre@scclie ~]$</span>
      <p class="bio">/ˈsʌk.kʊ.li/</p>
    </div>
  </div>

  <div class="card-content">
    <slot />
  </div>

  <div class="card-footer">
    <span>{currentTab}.md</span>
    <div class="easter-egg-container">
      <span class="vim-input" id="vim-input-display"></span>
      <span class="symbol" id="vim-easter-egg">Type :qa! and press &ltEnter&gt</span>
    </div>
  </div>
</div>

<script>
  // Простые пиксельные тени
  class PixelShadowEffect {
    constructor() {
      this.card = document.querySelector('.card');
      if (!this.card) return;
      
      this.accentColor = getComputedStyle(this.card).getPropertyValue('--card-accent').trim();
    }
    
    generatePixelShadows() {
      const shadows = [];
      shadows.push(`4px 0 0 ${this.accentColor}`);
      shadows.push(`-4px 0 0 ${this.accentColor}`);
      shadows.push(`0 4px 0 ${this.accentColor}`);
      shadows.push(`0 -4px 0 ${this.accentColor}`);
      return shadows.join(', ');
    }
    
    applyShadow() {
      if (!this.card) return;
      this.card.style.boxShadow = this.generatePixelShadows();
    }
  }

  // Пасхалка для Vim-команды :qa!
  (function initVimEasterEgg() {
    // Полностью очищаем предыдущее состояние
    const oldOverlay = document.getElementById('black-overlay');
    if (oldOverlay) oldOverlay.remove();
    const oldReboot = document.getElementById('reboot-sequence');
    if (oldReboot) oldReboot.remove();
    
    let userInput = '';
    const targetCommand = ':qa!';
    let easterEggElement = null;
    let inputDisplay = null;
    let explosionTimeout = null;
    let reappearTimeout = null;
    let glitchInterval = null;
    let rebootInterval = null;
    
    function getElements() {
      easterEggElement = document.getElementById('vim-easter-egg');
      inputDisplay = document.getElementById('vim-input-display');
    }
    
    function resetEasterEgg() {
      userInput = '';
      if (inputDisplay) {
        inputDisplay.textContent = '';
        inputDisplay.style.opacity = '0';
        inputDisplay.style.color = ''; // Сбрасываем цвет
      }
      if (easterEggElement) {
        easterEggElement.textContent = 'Type :qa! and press <Enter>';
        easterEggElement.style.color = '';
        easterEggElement.style.animation = '';
      }
      
      if (explosionTimeout) clearTimeout(explosionTimeout);
      if (reappearTimeout) clearTimeout(reappearTimeout);
      if (glitchInterval) clearInterval(glitchInterval);
      if (rebootInterval) clearTimeout(rebootInterval);
      
      const overlay = document.getElementById('black-overlay');
      if (overlay) overlay.remove();
      
      const rebootSeq = document.getElementById('reboot-sequence');
      if (rebootSeq) rebootSeq.remove();
    }
    
    function init() {
      // Получаем свежие ссылки
      getElements();
      
      // Сбрасываем состояние
      resetEasterEgg();
      
      // Устанавливаем правильные цвета
      if (inputDisplay && easterEggElement) {
        const cardStyle = getComputedStyle(document.querySelector('.card'));
        const accentColor = cardStyle.getPropertyValue('--card-accent').trim();
        
        // Применяем цвет акцента к полю ввода
        inputDisplay.style.color = accentColor;
        
        // Убираем все лишние стили
        inputDisplay.style.opacity = '0';
        inputDisplay.style.transition = 'none';
      }
      
      // Переустанавливаем обработчик
      document.removeEventListener('keypress', handleKeyPress);
      document.addEventListener('keypress', handleKeyPress);
    }
    
    function updateInputDisplay() {
      if (!inputDisplay) return;
      
      if (userInput.length > 0) {
        inputDisplay.textContent = userInput;
        inputDisplay.style.opacity = '1';
      } else {
        inputDisplay.textContent = '';
        inputDisplay.style.opacity = '0';
      }
    }
    
    function handleKeyPress(e) {
      if (!easterEggElement || !inputDisplay) return;
      if (e.ctrlKey || e.altKey || e.metaKey) return;
      
      userInput += e.key;
      
      if (userInput.length > targetCommand.length) {
        userInput = userInput.slice(-targetCommand.length);
      }
      
      updateInputDisplay();
      
      if (userInput === targetCommand) {
        activateEasterEgg();
        userInput = '';
        updateInputDisplay();
      }
    }
    
    function terminalGlitch(element, intensity = 1) {
      if (!element) return;
      const chars = '!@#$%^&*()_+{}:"<>?|[];\',./';
      const originalText = element.textContent;
      let glitchCount = 0;
      
      const glitch = setInterval(() => {
        if (glitchCount > 10) {
          clearInterval(glitch);
          element.textContent = originalText;
          return;
        }
        
        let glitched = '';
        for (let i = 0; i < originalText.length; i++) {
          if (Math.random() > 0.7) {
            glitched += chars[Math.floor(Math.random() * chars.length)];
          } else {
            glitched += originalText[i];
          }
        }
        element.textContent = glitched;
        glitchCount++;
      }, 50);
    }
    
    function showRebootSequence() {
      const body = document.body;
      let step = 0;
      
      const rebootMessages = [
        '[  OK  ] Received SIGTERM from PID 1 (init)',
        '[  OK  ] Unmounting filesystems...',
        '[  OK  ] Deactivating swap...',
        '[  OK  ] Stopping user services...',
        '[  OK  ] Stopping system services...',
        '[  OK  ] Unmounting /home',
        '[  OK  ] Unmounting /tmp',
        '[  OK  ] Killing remaining processes...',
        '[  OK  ] All processes terminated',
        '[  OK  ] Syncing disks...',
        '[  OK  ] Unmounting /',
        '[ .... ] System is going down for reboot',
        '[  OK  ] Reboot initiated',
        '',
        '⠀⠀⠀⠀⠀⠀⢀⡤⣤⣀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⣀⡀⠀⠀⠀⠀⠀⠀',
        '⠀⠀⠀⠀⠀⢀⡏⠀⠀⠈⠳⣄⠀⠀⠀⠀⠀⣀⠴⠋⠉⠉⡆⠀⠀⠀⠀⠀',
        '⠀⠀⠀⠀⠀⢸⠀⠀⠀⠀⠀⠈⠉⠉⠙⠓⠚⠁⠀⠀⠀⠀⣿⠀⠀⠀⠀⠀',
        '⠀⠀⠀⠀⢀⠞⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠹⣄⠀⠀⠀⠀',
        '⠀⠀⠀⠀⡞⠀⠀⠀⠀⠀⠶⠀⠀⠀⠀⠀⠀⠦⠀⠀⠀⠀⠀⠸⡆⠀⠀⠀',
        '⢠⣤⣶⣾⣧⣤⣤⣀⡀⠀⠀⠀⠀⠈⠀⠀⠀⢀⡤⠴⠶⠤⢤⡀⣧⣀⣀⠀',
        '⠻⠶⣾⠁⠀⠀⠀⠀⠙⣆⠀⠀⠀⠀⠀⠀⣰⠋⠀⠀⠀⠀⠀⢹⣿⣭⣽⠇',
        '⠀⠀⠙⠤⠴⢤⡤⠤⠤⠋⠉⠉⠉⠉⠉⠉⠉⠳⠖⠦⠤⠶⠦⠞⠁⠀⠀⠀',
        '',
        '',
        '',
        'Restarting system...',
        '',
        ''
      ];
      
      const rebootContainer = document.createElement('div');
      rebootContainer.id = 'reboot-sequence';
      rebootContainer.style.cssText = `
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        color: #00ff00;
        font-size: 18px;
        font-family: 'VT323', 'Courier New', monospace;
        z-index: 10000;
        white-space: pre;
        text-align: left;
        line-height: 1.8;
        text-shadow: 0 0 5px #00ff00;
        background: #000000;
        padding: 30px;
        border: 2px solid #00ff00;
        max-width: 600px;
        width: 90%;
      `;
      body.appendChild(rebootContainer);
      
      function printNextMessage() {
        if (step < rebootMessages.length) {
          const line = document.createElement('div');
          line.textContent = rebootMessages[step];
          line.style.cssText = `
            opacity: 1;
            color: #00ff00;
            margin-bottom: 4px;
            font-family: 'VT323', 'Courier New', monospace;
          `;
          rebootContainer.appendChild(line);
          
          step++;
          rebootInterval = setTimeout(printNextMessage, 400 + Math.random() * 300);
        } else {
          const cursor = document.createElement('span');
          cursor.textContent = '_';
          cursor.style.cssText = `
            color: #00ff00;
            font-size: 24px;
            animation: blink 1s step-end infinite;
            margin-left: 4px;
          `;
          rebootContainer.appendChild(cursor);
        }
      }
      
      printNextMessage();
    }
    
    function activateEasterEgg() {
      if (explosionTimeout) clearTimeout(explosionTimeout);
      if (reappearTimeout) clearTimeout(reappearTimeout);
      if (glitchInterval) clearInterval(glitchInterval);
      if (rebootInterval) clearTimeout(rebootInterval);
      
      getElements();
      
      if (easterEggElement) {
        easterEggElement.textContent = 'FORCE EXIT INITIATED';
        easterEggElement.style.color = '#ff0000';
      }
      
      if (inputDisplay) {
        inputDisplay.style.opacity = '0';
      }
      
      const card = document.querySelector('.card');
      const main = document.querySelector('main');
      const body = document.body;
      
      if (!card) return;
      
      const blackOverlay = document.createElement('div');
      blackOverlay.id = 'black-overlay';
      blackOverlay.style.cssText = `
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background-color: #000000;
        z-index: 9998;
        opacity: 0;
        transition: opacity 0.5s;
        pointer-events: none;
      `;
      body.appendChild(blackOverlay);
      
      if (easterEggElement) terminalGlitch(easterEggElement, 2);
      
      let shakeStep = 0;
      
      glitchInterval = setInterval(() => {
        if (shakeStep < 15) {
          const intensity = (15 - shakeStep) * 1.5;
          card.style.transform = `translate(${(Math.random() * intensity * 2) - intensity}px, ${(Math.random() * intensity) - intensity/2}px)`;
          card.style.opacity = Math.random() > 0.7 ? '0.9' : '1';
          
          if (shakeStep > 8) {
            card.style.filter = `brightness(${1 + Math.random()})`;
          }
          shakeStep++;
        } else {
          clearInterval(glitchInterval);
          
          blackOverlay.style.opacity = '1';
          card.style.transform = 'translate(0, 0) scale(0)';
          card.style.opacity = '0';
          
          if (main) {
            main.style.opacity = '0';
          }
          
          showRebootSequence();
          
          reappearTimeout = setTimeout(() => {
            const rebootSeq = document.getElementById('reboot-sequence');
            if (rebootSeq) rebootSeq.remove();
            
            blackOverlay.style.opacity = '0';
            
            setTimeout(() => {
              blackOverlay.remove();
            }, 500);
            
            if (main) {
              main.style.opacity = '1';
            }
            
            card.style.transform = 'translate(0, 0) scale(1)';
            card.style.opacity = '1';
            card.style.filter = 'none';
            card.style.boxShadow = `
              4px 0 0 var(--card-accent),
              -4px 0 0 var(--card-accent),
              0 4px 0 var(--card-accent),
              0 -4px 0 var(--card-accent)
            `;
            
            if (easterEggElement) {
              easterEggElement.textContent = 'Type :qa! and press <Enter>';
              easterEggElement.style.color = '';
            }
            
            userInput = '';
            if (inputDisplay) {
              inputDisplay.textContent = '';
              inputDisplay.style.opacity = '0';
            }
          }, 14000);
        }
      }, 60);
    }
    
    // Запускаем при загрузке
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
    
    // Для ViewTransitions - полная перезагрузка
    document.addEventListener('astro:page-load', () => {
      // Удаляем все старые элементы
      const oldOverlay = document.getElementById('black-overlay');
      if (oldOverlay) oldOverlay.remove();
      const oldReboot = document.getElementById('reboot-sequence');
      if (oldReboot) oldReboot.remove();
      
      // Запускаем инициализацию с задержкой
      setTimeout(init, 50);
    });
    
    // Очищаем при уходе
    document.addEventListener('astro:before-swap', () => {
      document.removeEventListener('keypress', handleKeyPress);
      const overlay = document.getElementById('black-overlay');
      if (overlay) overlay.remove();
      const reboot = document.getElementById('reboot-sequence');
      if (reboot) reboot.remove();
    });
    
    // Добавляем стили
    const style = document.createElement('style');
    style.textContent = `
      .easter-egg-container {
        display: flex;
        gap: 8px;
        align-items: center;
      }
      
      .vim-input {
        font-size: 20px;
        opacity: 0;
        transition: none;
        font-family: 'VT323', 'Courier New', monospace;
        background: transparent;
        padding: 0;
        letter-spacing: 1px;
      }
      
      .vim-input::before {
        content: '>';
        margin-right: 4px;
        opacity: 0.7;
        font-family: 'VT323', 'Courier New', monospace;
      }
      
      .card-footer {
        transition: none;
      }
      
      main {
        transition: none;
      }
      
      .card {
        transition: none;
      }
      
      @keyframes blink {
        0%, 100% { opacity: 1; }
        50% { opacity: 0; }
      }
    `;
    document.head.appendChild(style);
  })();
</script>

<style>
  .card {
    max-width: 900px;
    width: 100%;
    margin: 0 auto;
    background: var(--bg);
    position: relative;
    padding: 25px;
    border: 2px solid var(--card-accent);
    image-rendering: pixelated;
    image-rendering: crisp-edges;
    -ms-interpolation-mode: nearest-neighbor;
    will-change: transform, opacity, filter;
    box-shadow: 4px 0 0 var(--card-accent),
                -4px 0 0 var(--card-accent),
                0 4px 0 var(--card-accent),
                0 -4px 0 var(--card-accent);
  }
  
  .card-header {
    display: flex;
    gap: 20px;
    align-items: center;
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--card-accent);
  }
  
  .avatar {
    width: 80px;
    height: 80px;
    border: 2px solid var(--card-accent);
    image-rendering: pixelated;
    image-rendering: crisp-edges;
    -ms-interpolation-mode: nearest-neighbor;
    flex-shrink: 0;
  }
  
  .header-info {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  
  .user {
    color: var(--card-accent);
    font-size: 30px;
    font-weight: bold;
  }
  
  .bio {
    color: var(--fg-dim);
    font-size: 20px;
    margin-top: 8px;
    line-height: 1.6;
  }
  
  .card-content {
    min-height: 300px;
    color: var(--fg);
    font-size: 20px;
    line-height: 2;
  }
  
  .card-footer {
    margin-top: 30px;
    padding-top: 15px;
    border-top: 1px solid var(--card-accent);
    display: flex;
    justify-content: space-between;
    font-size: 20px;
    color: var(--fg-dim);
  }
  
  .symbol {
    color: var(--card-accent);
    transition: none;
    cursor: default;
  }
  
  @media (max-width: 767px) {
    .card {
      margin: 5px;
      padding: 5px;
    }
    
    .card-header {
      flex-direction: column;
      text-align: center;
      align-items: center;
    }
    
    .avatar {
      width: 128px;
      height: 128px;
    }
    
    .card-content {
      font-size: 12px;
      min-height: 20px;
    }
    
    .card-footer {
      font-size: 16px;
      flex-direction: column;
      gap: 10px;
      text-align: center;
    }
    
    .easter-egg-container {
      justify-content: center;
    }
    
    #reboot-sequence {
      font-size: 14px !important;
      padding: 15px !important;
    }
  }
</style>
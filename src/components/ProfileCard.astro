---
export interface Props {
  currentTab: string;
}

const { currentTab = 'contacts' } = Astro.props;

const tabs = [
  { id: 'contacts', label: 'Contacts', icon: '💬', href: '/contacts' },
  { id: 'projects', label: 'Projects', icon: '🚀', href: '/projects' },
  { id: 'peripherals', label: 'Peripherals', icon: '🖥️', href: '/peripherals' }
];

const contacts = [
  { platform: 'Discord', username: '@sccl', url: 'https://discord.com/users/sccl', icon: 'https://cdn.simpleicons.org/discord/88c0d0' },
  { platform: 'Telegram', username: '@papersaccul', url: 'https://t.me/papersaccul', icon: 'https://cdn.simpleicons.org/telegram/88c0d0' },
  { platform: 'Github', username: 'papersaccul', url: 'https://github.com/papersaccul', icon: 'https://cdn.simpleicons.org/github/88c0d0'},
  { platform: 'Steam', username: 'papersacculos', url: 'https://steamcommunity.com/id/papersacculos/', icon: 'https://cdn.simpleicons.org/steam/88c0d0' },
  { platform: 'YouTube', username: '@papersaccul', url: 'https://www.youtube.com/@papersaccul', icon: 'https://cdn.simpleicons.org/youtube/88c0d0' }
];

const projects = [
  { title: 'Wiki', description: 'Personal knowleage base with my articles', url: 'https://wiki.sccl.cc', icon: 'https://cdn.simpleicons.org/bookstack/88c0d0'},
  { title: 'HeatKeys', description: 'Keyboard layout heatmap', url: 'https://heatkeys.sccl.cc', icon: 'https://cdn.simpleicons.org/hotjar/88c0d0' }
];

const peripherals = [
  { category: 'CPU', items: ['AMD Ryzen 5 5600X @ 4.7GHz'] },
  { category: 'GPU', items: ['AMD Radeon RX 6750 XT (12GiB)'] },
  { category: 'RAM', items: ['32GiB DDR4-3333 CL16'] },
  { category: 'Monitor', items: ['MSI 26.5" MAG 272QP X50 (QD-OLED, 1440p, 500Hz)'] },
  { category: 'Mouses', items: ['Ninjutso Sora V2 (Artisan P8 dots)', 'Lamzu Thorn (X-Raypad Obsidian)'] },
  { category: 'Pads', items: ['Artisan Raiden Mid DaiDai', 'Artisan Key-83 Soft Ninja Black', 'MeowGamingGear UltraNeon XSoft Blue', 'X-Raypad Aqua-Control 2 Sakura blue', 'Razer Gigantus v2 Black'] },
  { category: 'Arm Sleeve', items: ['CisA v2 navy'] },
  { category: 'Keyboard', items: ['M1W Custom (Boba U4T)'] },
  { category: 'Audio', items: ['Arturia MiniFuse 2', 'Philips shp9500', 'Maono PD100 XLR'] }
];
---

<div class="w-full max-w-4xl h-[85vh] min-h-[600px] max-h-[800px]">
  <div class="bg-nord-6 dark:bg-nord-0 rounded-2xl border border-nord-4 dark:border-nord-2 shadow-2xl overflow-hidden h-full flex flex-col">
    <div class="grid md:grid-cols-3 flex-1 overflow-hidden">
      <!-- Левая колонка - Профиль -->
      <div class="md:col-span-1 bg-gradient-to-br from-nord-8/10 to-nord-10/10 dark:from-nord-1 dark:to-nord-2 p-8 flex flex-col overflow-hidden">
        <div class="text-center md:text-left flex flex-col h-full">
          <!-- Аватар -->
          <div class="flex-shrink-0">
            <div class="relative w-24 h-24 mx-auto md:mx-0 mb-6">
              <!-- свечение-->
              <div class="absolute -inset-3 rounded-full bg-gradient-to-r from-pink-500/40 to-purple-500/40 blur-xl animate-pulse"></div>
              <div class="absolute -inset-2 rounded-full bg-gradient-to-br from-purple-400/30 to-pink-500/30 blur-lg"></div>
              
              <!-- Аватарка  -->
              <div class="relative w-24 h-24 rounded-full flex items-center justify-center border-2 border-white/20 shadow-2xl overflow-hidden bg-transparent group backdrop-blur-sm">
                <img 
                  src="/img/pfp.jpg" 
                  alt="sccl" 
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                />
                <div class="w-full h-full bg-gradient-to-br from-purple-500 to-pink-500 hidden items-center justify-center">
                  <span class="text-2xl text-white font-bold">SC</span>
                </div>
              </div>
            </div>
          </div>
          
          <!-- Ник -->
          <div class="flex-shrink-0">
            <h1 class="text-3xl font-bold text-gradient-chrome animate-glow-chrome mb-2 relative">
              paper_sacculos
            </h1>
          </div>
          
          <!-- Теги -->
          <div class="flex-shrink-0 mb-6">
            <div class="flex flex-wrap gap-2 justify-center md:justify-start">
              <span class="px-3 py-1 bg-nord-8/20 text-nord-10 dark:text-nord-8 text-sm rounded-full border border-nord-8/30">Developer</span>
              <span class="px-3 py-1 bg-nord-9/20 text-nord-10 dark:text-nord-9 text-sm rounded-full border border-nord-9/30">Aimer</span>
            </div>
          </div>
          
          <!-- Обо мне -->
          <div class="flex-1 min-h-0 mb-6">
            <div class="prose prose-sm dark:prose-invert h-full">
              <p class="text-nord-2 dark:text-nord-4 leading-relaxed">
                
              </p>
            </div>
          </div>
        </div>
      </div> 
      
      <!-- Правая колонка - Вкладки -->
      <div class="md:col-span-2 p-8 flex flex-col overflow-hidden">
        <!-- Переключатель вкладок -->
        <div class="flex space-x-1 mb-8 p-1 bg-nord-5 dark:bg-nord-1 rounded-lg shrink-0">
          {tabs.map((tab) => (
            <a
              href={tab.href}
              class={`flex items-center space-x-2 px-4 py-2 rounded-md text-sm font-medium transition-all duration-300 flex-1 justify-center ${
                currentTab === tab.id
                  ? 'bg-nord-6 dark:bg-nord-0 text-nord-10 shadow-sm'
                  : 'text-nord-3 dark:text-nord-4 hover:text-nord-1 dark:hover:text-nord-6'
              }`}
            >
              <span>{tab.icon}</span>
              <span class="hidden sm:inline">{tab.label}</span>
            </a>
          ))}
        </div>
        
        <!-- Контент вкладок -->
        <div class="flex-1 min-h-0 overflow-hidden relative">
          <div class="h-full overflow-y-auto scrollbar-custom pr-4">
            <!-- Контакты -->
            {currentTab === 'contacts' && (
              <div class="space-y-4 animate-fade-in">
                {contacts.map((contact) => (
                  <a 
                    href={contact.url} 
                    target="_blank"
                    class="flex items-center space-x-4 p-4 rounded-lg hover:bg-nord-5 dark:hover:bg-nord-1 transition-all duration-300 group border border-nord-4/50 dark:border-nord-2/50"
                  >
                    <div class="w-8 h-8 flex items-center justify-center">
                      <img 
                        src={contact.icon} 
                        alt={contact.platform}
                        class="w-6 h-6 transition-all duration-300 group-hover:scale-110 group-hover:brightness-125"
                        loading="lazy"
                      />
                    </div>
                    <div class="flex-1">
                      <h3 class="font-semibold text-nord-1 dark:text-nord-6 group-hover:text-nord-8">
                        {contact.platform}
                      </h3>
                      <p class="text-sm text-nord-3 dark:text-nord-4 group-hover:text-nord-8">
                        {contact.username}
                      </p>
                    </div>
                    <span class="text-nord-4 dark:text-nord-2 group-hover:text-nord-8">→</span>
                  </a>
                ))}
              </div>
            )}
            
            <!-- Продукты -->
            {currentTab === 'projects' && (
              <div class="grid gap-4 animate-fade-in">
                {projects.map((product) => (
                  <a 
                    href={product.url} 
                    target="_blank"
                    class="block p-4 rounded-lg hover:bg-nord-5 dark:hover:bg-nord-1 transition-all duration-300 group border border-nord-4/50 dark:border-nord-2/50"
                  >
                    <div class="flex items-center space-x-4">
                      <div class="w-8 h-8 flex items-center justify-center">
                        <img 
                          src={product.icon} 
                          alt={product.title}
                          class="w-6 h-6 transition-all duration-300 group-hover:scale-110 group-hover:brightness-125"
                          loading="lazy"
                          onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                        />
                        <div class="w-6 h-6 bg-nord-8 rounded flex items-center justify-center text-nord-6 text-xs font-bold hidden">
                          {product.title.charAt(0)}
                        </div>
                      </div>
                      <div class="flex-1">
                        <h3 class="font-semibold text-nord-1 dark:text-nord-6 group-hover:text-nord-8 mb-1">
                          {product.title}
                        </h3>
                        <p class="text-sm text-nord-3 dark:text-nord-4">
                          {product.description}
                        </p>
                      </div>
                      <span class="text-nord-4 dark:text-nord-2 group-hover:text-nord-8">↗</span>
                    </div>
                  </a>
                ))}
              </div>
            )}
            
            <!-- Периферия -->
            {currentTab === 'peripherals' && (
              <div class="space-y-6 animate-fade-in pb-4">
                {peripherals.map((peripheral) => (
                  <div class="border-b border-nord-4/30 dark:border-nord-2/30 pb-4 last:border-b-0 last:pb-0">
                    <h3 class="font-semibold text-nord-1 dark:text-nord-6 mb-3 text-sm uppercase tracking-wider">
                      {peripheral.category}
                    </h3>
                    <div class="space-y-2">
                      {peripheral.items.map((item) => (
                        <div class="flex items-center space-x-3 text-sm text-nord-2 dark:text-nord-4">
                          <div class="w-1.5 h-1.5 bg-nord-8 rounded-full flex-shrink-0"></div>
                          <span class="break-words">{item}</span>
                        </div>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .animate-fade-in {
    animation: fadeIn 0.3s ease-in-out;
  }
  
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .prose {
    max-width: none;
  }
  
  /* Chrome-совместимый градиентный текст */
  .text-gradient-chrome {
    background: linear-gradient(135deg, #ec4899, #a855f7);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    /* Fallback для случаев когда background-clip не работает */
    -webkit-text-fill-color: transparent;
  }
  
  /* Fallback цвет для темной темы */
  .dark .text-gradient-chrome {
    background: linear-gradient(135deg, #f472b6, #c084fc);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  
  /* Glow Chrome */
  @keyframes glowChrome {
    0%, 100% {
      filter: drop-shadow(0 0 8px rgba(236, 72, 153, 0.4));
    }
    50% {
      filter: drop-shadow(0 0 16px rgba(168, 85, 247, 0.6));
    }
  }
  
  .animate-glow-chrome {
    animation: glowChrome 3s ease-in-out infinite;
  }
  
  /* скроллбар */
  .scrollbar-custom {
    scrollbar-width: thin;
    scrollbar-color: #88c0d0 transparent;
  }
  
  .scrollbar-custom::-webkit-scrollbar {
    width: 8px;
  }
  
  .scrollbar-custom::-webkit-scrollbar-track {
    background: transparent;
    border-radius: 4px;
    margin: 4px 0;
  }
  
  .scrollbar-custom::-webkit-scrollbar-thumb {
    background: linear-gradient(135deg, #88c0d0, #81a1c1);
    border-radius: 4px;
    border: 2px solid transparent;
    background-clip: padding-box;
    transition: all 0.3s ease;
  }
  
  .scrollbar-custom::-webkit-scrollbar-thumb:hover {
    background: linear-gradient(135deg, #81a1c1, #5e81ac);
    border: 1px solid transparent;
    background-clip: padding-box;
  }
  
  .scrollbar-custom::-webkit-scrollbar-thumb:active {
    background: linear-gradient(135deg, #5e81ac, #4c566a);
  }
  
  .dark .scrollbar-custom::-webkit-scrollbar-thumb {
    background: linear-gradient(135deg, #4c566a, #434c5e);
  }
  
  .dark .scrollbar-custom::-webkit-scrollbar-thumb:hover {
    background: linear-gradient(135deg, #434c5e, #3b4252);
  }
  
  .dark .scrollbar-custom::-webkit-scrollbar-thumb:active {
    background: linear-gradient(135deg, #3b4252, #2e3440);
  }
  
  /* Плавная прокрутка */
  .scrollbar-custom {
    scroll-behavior: smooth;
  }
  
  /* Прозрачность скроллбара */
  .scrollbar-custom::-webkit-scrollbar-thumb {
    opacity: 0.7;
  }
  
  .scrollbar-custom:hover::-webkit-scrollbar-thumb {
    opacity: 1;
  }
</style>

<script>
  // scrollbar
  document.addEventListener('DOMContentLoaded', function() {
    const scrollContainers = document.querySelectorAll('.scrollbar-custom');
    
    scrollContainers.forEach(container => {
      // smoooooooooooooooth
      container.addEventListener('wheel', function(e) {
        e.preventDefault();
        this.scrollBy({
          top: e.deltaY * 0.5,
          behavior: 'smooth'
        });
      }, { passive: false });
    });
  });
</script>
                        "0x4F3A",
                        "0xBADC0DE",
                        "0xC0DEBABE",
                        "����",
                        "����������������������������������������",
                        "��������",
                        "��������������",
                        "�",
                        "�",
                        "�",
                        "�",
                        "�",
                        "�",
                        "�",
                        "�",
                        "▐",

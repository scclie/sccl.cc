---
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
}

const { title, description = "Personal site" } = Astro.props;
---

<!DOCTYPE html>
<html lang="ru" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/gif" href="/img/logo.gif" />
    <title>{title}</title>
    
    <!-- Preload fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Theme detection script -->
    <script is:inline>
      const theme = localStorage.getItem('theme') || 
                   (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.classList.toggle('dark', theme === 'dark');
    </script>
  </head>
  <body class="bg-nord-6 dark:bg-nord-0 text-nord-0 dark:text-nord-6 min-h-screen overflow-x-hidden">
    <!-- Amim waves-->
    <div class="wave-container">
      <svg class="wave-svg" viewBox="0 0 1200 600" preserveAspectRatio="none">
      
        <!-- Wave 1  -->
        <path class="wave-path wave-1" d="M-200,150 C100,100 400,200 800,150 C1100,100 1300,200 1400,150 L1400,600 L-200,800 Z" />

        <!-- Wave 2  -->
        <path class="wave-path wave-2" d="M-200,200 C50,180 350,220 600,200 C850,180 1150,220 1400,200 L1400,600 L-200,800 Z" />

        <!-- Wave 3  -->
        <path class="wave-path wave-3" d="M-200,250 C0,230 300,270 600,250 C900,230 1200,270 1400,250 L1400,600 L-200,800 Z" />

        <!-- Wave 4  -->
        <path class="wave-path wave-4" d="M-200,300 C150,280 350,320 600,300 C850,280 1050,320 1400,300 L1400,600 L-200,800 Z" />

        <!-- Wave 5  -->
        <path class="wave-path wave-5" d="M-200,350 C100,330 350,370 600,350 C850,330 1100,370 1400,350 L1400,600 L-200,800 Z" />

        <!-- Wave 6  -->
        <path class="wave-path wave-6" d="M-200,400 C50,380 350,420 600,400 C850,380 1150,420 1400,400 L1400,600 L-200,800 Z" />

        <!-- Wave 7  -->
        <path class="wave-path wave-7" d="M-200,450 C200,430 300,470 600,450 C900,430 1000,470 1400,450 L1400,600 L-200,800 Z" />

        <!-- Wave 8  -->
        <path class="wave-path wave-8" d="M-200,500 C0,480 350,520 600,500 C850,480 1200,520 1400,500 L1400,600 L-200,800 Z" />

        <!-- Wave 9  -->
        <path class="wave-path wave-9" d="M-200,550 C100,530 350,570 600,550 C850,530 1100,570 1400,550 L1400,600 L-200,800 Z" />
      </svg>
    </div>

    <!-- Основной контент -->
    <div class="relative z-10">
      <slot />
    </div>

      <script>
        const waves = document.querySelectorAll('.wave-path');
        
        function animateWaves() {
          const time = Date.now() * 0.001;

          waves.forEach((wave, index) => {
            const offset = index * 0.5;
            const amplitude = 8 + index * 3;
            const frequency = 0.3 + index * 0.1;

            const translateY = Math.sin(time * frequency + offset) * amplitude;
            const scaleY = 0.95 + Math.sin(time * frequency * 0.7 + offset) * 0.05;
            wave.style.transform = `translateY(${translateY}px) scaleY(${scaleY})`;
          });

          requestAnimationFrame(animateWaves);
        }

        document.addEventListener('DOMContentLoaded', animateWaves);
      </script>
  </body>
</html>

<style>
  .wave-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: -1;
    overflow: hidden;
  }

  .wave-svg {
    position: absolute;
    width: 120%; 
    height: 100vh;
    min-height: 100vh;
    left: -10%; 
  }

  .wave-path {
    opacity: 0.7;
    transform-origin: center;
  }

  .wave-1 {
    fill: #d8dee9 
  }

  .wave-2 {
    fill: #e5e9f0 
  }

  .wave-3 {
    fill: #eceff4
  }

  .wave-4 {
    fill: #e5e9f0 
  }

  .wave-5 {
    fill: #eceff4
  }

  .wave-6 {
    fill: #d8dee9 
  }

  .wave-7 {
    fill: #e5e9f0 
  }

  .wave-8 {
    fill: #d8dee9
  }

  .wave-9 {
    fill: #eceff4
  }

  .dark .wave-1 {
  fill: #434c5e;
}

.dark .wave-2 {
  fill: #4c566a;
}

.dark .wave-3 {
  fill: #434c5e;
}

.dark .wave-4 {
  fill: #3b4252;
}

.dark .wave-5 {
  fill: #434c5e;
}

.dark .wave-6 {
  fill: #3b4252;
}

.dark .wave-7 {
  fill: #434c5e;
}

.dark .wave-8 {
  fill: #4c566a;
}

.dark .wave-9 {
  fill: #4c566a;
}

  /* Адаптивность */
  @media (max-width: 768px) {
    .wave-svg {
      width: 140%; 
      left: -20%;
    }
  }

  html, body {
    height: 100%;
    margin: 0;
    padding: 0;
  }
</style>
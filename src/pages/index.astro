import ProfileCard from '../components/ProfileCard.astro';

const tabs = ['contacts', 'projects', 'peripherals'];
const currentTab = Astro.url.pathname.split('/')[1] || 'contacts';
---

<BaseLayout title="sccl.cc">
  <main>
    <ProfileCard currentTab={currentTab} />
  </main>
</BaseLayout>
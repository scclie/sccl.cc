---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProfileCard from '../components/ProfileCard.astro';

const tabs = ['contacts', 'projects', 'peripherals'];
const path = Astro.url.pathname;
const currentTab = path.split('/')[1] || 'contacts';

// Редирект с корневого пути на /contacts
if (path === '/' || path === '') {
  return Astro.redirect('/contacts');
}
---

<BaseLayout title="sccl.cc">
  <main>
    <ProfileCard currentTab={currentTab} />
  </main>
</BaseLayout>
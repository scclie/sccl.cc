---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProfileCard from '../components/ProfileCard.astro';
---

<BaseLayout title="Peripherals - sccl.cc">
  <main>
    <ProfileCard currentTab="peripherals">
      <div class="peripherals-content">
        <div class="peripheral-section">
          <span class="peripheral-label">OS:</span>
          <span class="peripheral-value">NixOs 25.11 (linux 6.18.8), niri (Wayland)</span>
        </div>

        <div class="peripheral-section">
          <span class="peripheral-label">CPU:</span>
          <span class="peripheral-value">AMD Ryzen 5 5600X @ 4.7GHz</span>
        </div>

        <div class="peripheral-section">
          <span class="peripheral-label">GPU:</span>
          <span class="peripheral-value">AMD Radeon RX 6750 XT (12GiB)</span>
        </div>

        <div class="peripheral-section">
          <span class="peripheral-label">RAM:</span>
          <span class="peripheral-value">32GiB DDR4-3333 CL16 </span>
        </div>

        <div class="peripheral-section">
          <span class="peripheral-label">Storage:</span>
          <span class="peripheral-value">512GiB NVMe + 1312GiB Sata3 SSD</span>
        </div>

        <div class="peripheral-section">
          <span class="peripheral-label">Display 0:</span>
          <span class="peripheral-value">MSI 26.5" MAG 272QP X50 (qd-oled, 1440p, 500Hz)</span>
        </div>
      </div>
    </ProfileCard>
  </main>
</BaseLayout>

<style>
  .peripherals-content {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  .peripheral-section {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .peripheral-label {
    color: var(--peripherals-accent);
    font-size: 20px;
  }

  .peripheral-value {
    color: var(--fg);
    font-size: 20px;
  }
  
  /* Responsive design - Mobile */
  @media (max-width: 767px) {
    .peripheral-label {
      font-size: 20px;
    }
    
    .peripheral-value {
      font-size: 20px;
      word-break: break-word;
    }
  }
</style>